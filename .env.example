# Ambiente ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Conexão com o PostgreSQL do Supabase (obrigatória)
# No painel do Supabase: Connect → Session pooler. Troque [YOUR-PASSWORD] pela senha do banco.
ConnectionStrings__DefaultConnection=postgresql://postgres.<id-do-projeto>:[YOUR-PASSWORD]@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Chave secreta que assina os tokens de login (obrigatória, mínimo 32 caracteres)
# Gere uma com: openssl rand -base64 48
# Use uma chave diferente em cada ambiente e nunca a coloque no repositório.
# Trocar a chave desloga todo mundo (os tokens antigos deixam de valer).
JWT_SIGNING_KEY=

# Origens permitidas para CORS (separadas por vírgula, sem barra no final)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000

# Login com Google (opcional em desenvolvimento: sem elas, /api/auth/google responde 503)
# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth (tipo "Aplicativo da Web").
# O segredo nunca vai para o site nem para o repositório.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
