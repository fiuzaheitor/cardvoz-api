# Ambiente ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Conexão com o PostgreSQL do Supabase (obrigatória)
# No painel do Supabase: Connect → Session pooler. Troque [YOUR-PASSWORD] pela senha do banco.
ConnectionStrings__DefaultConnection=postgresql://postgres.<id-do-projeto>:[YOUR-PASSWORD]@aws-0-<regiao>.pooler.supabase.com:5432/postgres

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000
