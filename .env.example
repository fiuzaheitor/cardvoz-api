# Ambiente ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Conexão com o Banco de Dados
# Padrão: SQLite local (arquivo cardvoz.db criado automaticamente na raiz da API)
ConnectionStrings__DefaultConnection=Data Source=cardvoz.db

# Alternativa: MySQL (se configurado, a API detecta e conecta via Pomelo EF Core)
# ConnectionStrings__DefaultConnection=Server=127.0.0.1;Port=3306;Database=cardvoz;Uid=root;Pwd=sua_senha;CharSet=utf8mb4;

# Origens permitidas para CORS (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000
